---

<section class="section news-section">
    <div class="max-content">

        <div class="title-container" data-aos="fade-up">
            <h2>ULTIMAS NOTICIAS</h2>
        </div>

        <div class="news-card-container">

            <!-- Card 1 -->
            <div class="news-card" data-aos="fade-right">
                <img src="/assets/images/kiosko.webp" alt="Foto del Kiosko">
                <h3>Nueva Cabina</h3>
                <p>
                    Nueva locación del kiosko escolar. Relizado por los chicos de 6to TEIE.
                </p>
            </div>

            <!-- Card 2 -->
            <div class="news-card" data-aos="fade-up">
                <img src="/assets/images/camara.webp" alt="Foto de la camara">
                <h3>Cámara de seguridad</h3>
                <p>
                    Instalación de nuevas cámaras de vigilancia para mayor seguridad en la escuela.
                </p>
            </div>

            
            <!-- Card 3 -->
            <div class="news-card" data-aos="fade-left">
                <img src="/assets/images/taller-5-nuevo.webp" alt="nuevo salon de taller de 5to tipp">
                <h3>Nueva aula</h3>
                <p>
                    Inaguración de un nuevo salón en la escuela para el taller de 5to TIPP.
                </p>
            </div>


        </div>

    </div>
</section>

<style>
    .news-section{
        display: flex;
        justify-content: center;
        margin-top: 100px;
    }

    .max-content{
        flex-direction: column;
        align-items: center;
    }

    img{
        width: 250px;
        height: 250px;
        border-radius: 20px;
    }

    .news-card-container{
        display: flex;
        align-items: center;
        justify-content: center;
        background-image: url('/assets/images/news-blue.png');
        padding: 100px;
        background-repeat: no-repeat;
        background-position: right;
        background-position-y: top;
        background-size: 70% 100%;
        gap: 20px;

    }


    .news-card{
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        width: 300px;
        text-align: center;
        padding: 20px;
        background: #0d3d7f7f;
        border-radius: 20px;
        color: #fff;
        height: 450px;
    }


    .news-card h3{
        font-size: 2rem;
    }

    h2{
        color: #fff;
        font-size: 2.5rem;
    }


    @media screen and (max-width: 768px) {
        .max-content{
            flex-direction: column;
            align-items: center;
        }

        .news-card-container{
            flex-direction: column;
            align-items: center;
            background-image: none;
            padding: 0;
        }
    }
</style>