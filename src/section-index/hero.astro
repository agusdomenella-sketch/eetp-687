
---
import Header from '../components/header.astro';
---

<Header />

<section class="section hero-section">

    <div class="title-hero-container">
        <h1 data-aos="fade-up">
            <span>EETP - EESO N° 687</span>
        </h1>
        <h1 data-aos="fade-up">
            <span>"República de Venezuela"</span>
        </h1>
        <h3 data-aos="fade-up">- 75 años educando técnicos -</h3>
    </div>

</section>

<style>
    .hero-section {
        position: relative;
        min-height: 100vh;
        min-height: 100svh;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
        box-sizing: border-box;
        background-image: url('/assets/images/escuelaPantallaPrincipal.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .hero-section::before {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.30);
        z-index: 1;
    }

    .title-hero-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 1280px;
        position: relative;
        z-index: 2;
        padding: 0;
        box-sizing: border-box;
    }

    .title-hero-container h1 {
        font-family: 'Alata', sans-serif;
        font-size: 5.5rem;
        font-weight: 600;
        line-height: 1.15;
        color: #fff;
        width: 100%;
        margin: 0 0 12px;
        padding: 0;
        text-wrap: balance;
        overflow-wrap: break-word;
    }

    .title-hero-container h3 {
        font-family: 'BonaNovaSC', sans-serif;
        font-size: 1.5rem;
        font-weight: 300;
        line-height: 1.4;
        color: #fffaaf;
        margin: 15px 0 0;
        padding: 0;
    }


@media screen and (max-width: 768px) {
    .hero-section {
        min-height: 85svh;
        padding: 30px 18px;
        background-position: center;
    }

    .title-hero-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        width: 100%;
        margin: 0 auto;
        gap: 8px;
    }

    .title-hero-container h1 {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        font-size: clamp(1.8rem, 6.5vw, 2.7rem);
        line-height: 1.25;
        text-align: center !important;
    }

    .title-hero-container h1 span {
        display: block;
        width: 100%;
        text-align: center !important;
        color: #fff;
        text-decoration: none !important;
        -webkit-text-decoration: none !important;
    }

    .title-hero-container h3 {
        width: 100%;
        max-width: 100%;
        margin: 12px 0 0;
        padding: 0;
        font-size: clamp(1rem, 4vw, 1.3rem);
        line-height: 1.5;
        text-align: center !important;
    }
}

@media screen and (max-width: 380px) {
    .title-hero-container h1 {
        font-size: 1.65rem;
    }

    .title-hero-container h3 {
        font-size: 0.95rem;
    }
}

    @media screen and (max-width: 380px) {
        .title-hero-container h1 {
            font-size: 1.65rem;
        }

        .title-hero-container h3 {
            font-size: 0.95rem;
        }
    }
</style>
