---
import Header from '../components/header.astro';
---


<Header />

<section class="section hero-section">

    <div class="title-hero-container">
        <h1 data-aos="fade-up">EETP - EESO N° 687 </h1>
        <h1 data-aos="fade-up">"República de Venezuela"</h1>
        <h3 data-aos="fade-up">- 75 años educando técnicos -</h3>
    </div>

</section>


<style>
    .hero-section{
        position: relative;
        min-height: 100vh;
        width: 100%;
        gap: 20px;
        display:flex;
        justify-content: center;
        align-items: center;

        background-image: url('/assets/images/escuelaPantallaPrincipal.jpg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    .hero-section::before{
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.30);
        z-index: 1;
    }

    .title-hero-container{
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        width: 100%;
        max-width: 1280px;
        position: relative;
        z-index: 2;
        padding-bottom: 30px;

    }

    h1{
        font-size: 5.5 rem;
        text-wrap: pretty;
        color: #fff;
        padding: 3px 3px 30px 3px;
        font-family:'Alata', sans-serif;
        font-weight:600;
    }

    h3 {
        font-family:'BonaNovaSC', sans-serif;
        font-weight:300;
        color: #fffaafee
    }


    @media screen and (max-width: 768px){
        h1{
            font-size: 3.5rem;
            width: 90%;
            margin-top: 50px;
        }
    }

    

</style>