<section class="section section-history">
    <div class="max-content">

        <div class="history-info" data-aos="fade-right">

            <div class="title-container">
                <h2>Camino a los 75 años de historia</h2>
            </div>

            <div class="history-text">
                <p>
                    Nuestra escuela cumple 75 años acompañando a generaciones
                    de estudiantes y formando jóvenes para su futuro.
                </p>

                <p>
                    A lo largo de estas décadas, la institución fue creciendo
                    y transformándose junto con las necesidades de la comunidad,
                    manteniendo siempre el compromiso con la educación, el
                    aprendizaje y la formación técnica.
                </p>

                <p>
                    Vivimos este camino mirando hacia atrás con orgullo,
                    valorando todo lo construido y, al mismo tiempo, mirando
                    hacia adelante para continuar formando a las nuevas
                    generaciones.
                </p>

                <a href="/75-anos" class="history-btn">
                    Conocé nuestra historia
                </a>

                <a href="/promociones" class="promos-btn">
                    Conocé nuestras promociones
                </a>


            </div>

        </div>


        <div class="history-images" data-aos="fade-left">

            <img
                src="/assets/images/historia-escuela-1.jpg"
                alt="Historia de la escuela"
                class="history-img history-img-1"
            >

            <img
                src="/assets/images/historia-escuela-2.jpg"
                alt="Historia de la escuela"
                class="history-img history-img-2"
            >

        </div>

    </div>
</section>


<style>

    .section-history{
        display: flex;
        justify-content: center;
        align-items: center;

        width: 100%;

        padding: 80px 0;

        background: var(--third-color);
    }


    .section-history .max-content{
        justify-content: space-evenly;
        align-items: center;

        gap: 60px;
    }

    .history-info{
        width: 500px;

        display: flex;
        flex-direction: column;
        align-items: center;

        gap: 25px;
    }


    .history-info .title-container{
        margin: 0;
        width: 100%;
    }


    .history-info h2{
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 2.5rem;

        text-align: center;
    }


    .history-text{
        display: flex;
        flex-direction: column;

        gap: 15px;

        text-align: center;
    }


    .history-text p{
        color: var(--color-text);

        font-size: 16px;
        line-height: 1.6;
    }

    .history-images{
        width: 500px;

        display: flex;
        flex-direction: column;

        gap: 20px;    
    }


    .history-img{
        width: 100%;
        height: 220px;

        object-fit: cover;

        border-radius: 20px;

        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.45);

        transition: transform .3s ease,
                    box-shadow .3s ease;
    }


    .history-img-1{
        height: 220px;
    }


    .history-img-2{
        height: 220px;
    }


    .history-img:hover{
        transform: translateY(-5px);

        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.48);
    }

    .history-btn{
        align-self: center;
        margin-top: 10px;
        padding: 12px 30px;
        background: var(--primary-color);
        color: #fff;
        text-decoration: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        border-radius: 30px;
        transition: .3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    }

    .history-btn:hover{
        transform: translateY(-3px);
        background: var(--secondary-color);
        box-shadow: 0 9px 20px rgba(0, 0, 0, 0.22);
    }

    .promos-btn{
        align-self: center;
        margin-top: 10px;
        padding: 12px 30px;
        background: var(--primary-color);
        color: #fff;
        text-decoration: none;
        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        border-radius: 30px;
        transition: .3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.15);
    }

    .promos-btn:hover{
        transform: translateY(-3px);
        background: var(--secondary-color);
        box-shadow: 0 9px 20px rgba(0, 0, 0, 0.22);
    }



    @media screen and (max-width: 768px){

        .section-history{
            padding: 60px 0;
        }


        .section-history .max-content{
            flex-direction: column;

            gap: 40px;

            width: 90%;
        }


        .history-info{
            width: 100%;
        }


        .history-info h2{
            font-size: 2rem;
        }


        .history-text p{
            font-size: 15px;
        }


        .history-images{
            width: 100%;

            grid-template-columns: 1fr 1fr;

            gap: 12px;
        }


        .history-img{
            height: 250px;
        }


        .history-img-1{
            height: 220px;
        }


        .history-img-2{
            height: 280px;
        }

    }

</style>