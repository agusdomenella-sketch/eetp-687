<style>
.title-container{
    width: fit-content;
    margin: 40px auto 40px;
    text-align: center;
}

.title-container h2{
    margin: 0px;
}    
     .timeline{
        width: 100%;
        max-width: 1200px;
        position: relative;
        margin: 50px auto 0;
        padding: 20px 0;
    }

    /* Línea central */
    .timeline::before{
        content: '';
        position: absolute;
        left: 50%;
        top: 0;
        bottom: 0;
        width: 4px;
        transform: translateX(-50%);
        background: linear-gradient(
            var(--primary-color),
            var(--fourth-color)
        );
        border-radius: 10px;
    }

    /* Cada evento */
    .timeline-item{
        position: relative;
        width: 100%;
        min-height: 240px;
        display: flex;
        align-items: center;
    }

    /* Fecha */
    .timeline-date{
        position: absolute;
        width: 50%;
        padding: 20px 35px;
        font-family: 'Montserrat', sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: var(--primary-color);
    }

    /* Punto central */
    .timeline-dot{
        position: absolute;
        left: 50%;
        top: 50%;
        width: 22px;
        height: 22px;
        transform: translate(-50%, -50%);
        background: var(--fourth-color);
        border: 5px solid var(--third-color);
        border-radius: 50%;
        z-index: 3;
        box-shadow: 0 0 0 3px var(--primary-color);
    }

    /* Carta */
    .timeline-card{
        width: calc(50% - 60px);
        padding: 30px;
        background: var(--secondary-color);
        color: #fff;
        border-radius: 22px;
        box-shadow: 0 12px 25px rgba(0,0,0,.16);
        transition: transform .3s ease, box-shadow .3s ease;
        box-sizing: border-box;
    }

    .timeline-card:hover{
        transform: translateY(-5px);
        box-shadow: 0 18px 30px rgba(0,0,0,.22);
    }

    .timeline-card span{
        font-family: 'Montserrat', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 2px;
        opacity: .7;
    }

    .timeline-card h3{
        margin: 8px 0;
        font-size: 1.7rem;
    }

    .timeline-card p{
        font-family: 'Montserrat', sans-serif;
        line-height: 1.6;
        font-size: 15px;
    }


    /* =========================================
    CARTAS ALTERNADAS
    ========================================= */

    /* IMPARES → CARTA A LA DERECHA */
    .timeline-item:nth-child(odd){
        justify-content: flex-end;
    }

    .timeline-item:nth-child(odd) .timeline-card{
        margin-right: 0;
    }

    .timeline-item:nth-child(odd) .timeline-date{
        left: 0;
        text-align: right;
        padding-right: 50px;
    }


    /* PARES → CARTA A LA IZQUIERDA */
    .timeline-item:nth-child(even){
        justify-content: flex-start;
    }

    .timeline-item:nth-child(even) .timeline-card{
        margin-left: 0;
    }

    .timeline-item:nth-child(even) .timeline-date{
        right: 0;
        text-align: left;
        padding-left: 50px;
    }


    /* =========================================
    MOBILE
    ========================================= */

    @media screen and (max-width: 768px){

        .timeline-section{
            padding: 60px 10px 80px;
        }

        .timeline{
            width: 95%;
            margin: 35px auto 0;
            padding-left: 30px;
        }

        .timeline::before{
            left: 10px;
            transform: none;
        }

        .timeline-item{
            min-height: auto;
            padding: 45px 0;
            display: block;
        }

        .timeline-dot{
            left: 10px;
            top: 50%;
            width: 18px;
            height: 18px;
            border-width: 4px;
        }

        .timeline-date{
            position: relative;
            left: auto !important;
            right: auto !important;
            width: auto;
            padding: 0 0 10px 25px !important;
            text-align: left !important;
            font-size: 14px;
        }

        .timeline-card{
            width: calc(100% - 25px);
            margin: 0 0 0 25px !important;
            padding: 25px;
        }

        .timeline-card h3{
            font-size: 1.4rem;
        }
}</style>