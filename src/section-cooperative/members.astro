<section class="section members-section">

    <div class="max-content">

        <div class="members-intro" data-aos="fade-up">

            <span style="color: red;">
                COOPERATIVA ESCOLAR
            </span>

            <h2>
                CONSEJO 2026
            </h2>

            <p>
                Conocé a los estudiantes que forman parte
                del Consejo de la Cooperativa Escolar.
            </p>

        </div>


        <div
            class="members-photo"
            data-aos="zoom-in"
        >

            <img
                src="/assets/images/cooperativa/coope-alum.jpeg"
                alt="Miembros del Consejo de la Cooperativa 2026"
            >

        </div>

    </div>

</section>


<style>

    .members-section{
        margin-top: 50px;

        padding: 100px 20px;

        background-image:
            linear-gradient(
                rgba(127, 13, 13, 0.34),
                rgba(196, 209, 77, 0.53)
            ),
            url('/assets/images/cooperativa/fondo-coope.webp');

        background-repeat: no-repeat;

        background-size: cover;

        background-position: center;
    }


    .max-content{
        flex-direction: column;

        align-items: center;
    }


    .members-intro{
        max-width: 750px;

        text-align: center;

        color: #fff;

        display: flex;

        flex-direction: column;

        align-items: center;

        gap: 15px;

        margin-bottom: 45px;
    }


    .members-intro span{
        font-family: 'Montserrat', sans-serif;

        font-size: 14px;

        font-weight: 700;

        letter-spacing: 3px;

        color: var(--fourth-color);
    }


    .members-intro h2{
        font-size: 3.5rem;
    }


    .members-intro p{
        font-size: 17px;

        line-height: 1.6;
    }


    .members-photo{
        width: 100%;

        max-width: 900px;

        padding: 10px;

        background: rgba(255,255,255,.15);

        border-radius: 30px;

        backdrop-filter: blur(5px);

        box-shadow:
            0 20px 40px rgba(0,0,0,.3);
    }


    .members-photo img{
        display: block;

        width: 100%;

        border-radius: 22px;
    }


    @media screen and (max-width: 768px){

        .members-section{
            padding: 70px 15px;
        }


        .members-intro h2{
            font-size: 2.5rem;
        }


        .members-intro p{
            font-size: 15px;
        }


        .members-photo{
            width: 90%;

            padding: 7px;
        }

    }

</style>