<section class="section hero-section">

    <div class="img-hero">

        <img
            class="img1"
            src="/assets/images/cooperativa/COOPEBLEBLE.webp"
            alt="Cooperativa Escolar"
        >

        <img
            class="img2"
            src="/assets/images/cooperativa/coope-celu.webp"
            alt="Cooperativa Escolar"
        >

    </div>

</section>


<style>

    .hero-section{
        width: 100%;
        height: 100vh;

        position: relative;

        overflow: hidden;

        margin: 0;
        padding: 0;
    }


    .img-hero{
        position: absolute;

        inset: 0;

        width: 100%;
        height: 100%;
    }


    .img-hero img{
        position: absolute;

        inset: 0;

        width: 100%;
        height: 100%;

        object-fit: cover;
    }


    .img2{
        display: none;
    }


    /* =========================
       CELULAR
    ========================= */

    @media screen and (max-width: 768px){

        .img1{
            display: none;
        }

        .img2{
            display: block;
        }

    }

</style>