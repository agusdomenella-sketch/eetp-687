<section class="section activities-info-section">

    <div class="max-content">

        <div class="title-container" data-aos="fade-up">
            <h2>LO QUE HACEMOS</h2>
        </div>


        <div class="activities-info-grid">


            <article
                class="activity-info"
                data-aos="fade-up"
            >

                <span>01</span>

                <div class="activity-icon">
                    🤝
                </div>

                <h3>
                    Participación
                </h3>

                <p>
                    Los estudiantes participan en la organización
                    y en la toma de decisiones de la cooperativa.
                </p>

            </article>


            <article
                class="activity-info"
                data-aos="fade-up"
                data-aos-delay="100"
            >

                <span>02</span>

                <div class="activity-icon">
                    🌱
                </div>

                <h3>
                    Compromiso
                </h3>

                <p>
                    Se desarrollan actividades y proyectos destinados
                    a colaborar con la escuela y la comunidad.
                </p>

            </article>


            <article
                class="activity-info"
                data-aos="fade-up"
                data-aos-delay="200"
            >

                <span>03</span>

                <div class="activity-icon">
                    📚
                </div>

                <h3>
                    Aprendizaje
                </h3>

                <p>
                    Capacitaciones, encuentros y experiencias permiten
                    conocer y practicar el cooperativismo.
                </p>

            </article>


            <article
                class="activity-info"
                data-aos="fade-up"
                data-aos-delay="300"
            >

                <span>04</span>

                <div class="activity-icon">
                    ❤️
                </div>

                <h3>
                    Solidaridad
                </h3>

                <p>
                    La cooperativa promueve acciones basadas en la
                    ayuda mutua y el vínculo con la comunidad.
                </p>

            </article>


        </div>

    </div>

</section>


<style>

    .activities-info-section{
        padding: 50px 20px 100px;

        background:
            linear-gradient(
                180deg,
                transparent,
                rgba(0, 74, 173, .04)
            );
    }


    .max-content{
        flex-direction: column;
        align-items: center;
    }


    .activities-info-grid{
        width: 100%;
        max-width: 1100px;

        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 20px;

        margin-top: 30px;
    }


    .activity-info{
        position: relative;

        padding: 30px 25px;

        min-height: 280px;

        background: #fff;

        border-radius: 22px;

        border-top: 5px solid var(--primary-color);

        box-shadow:
            0 10px 25px rgba(0,0,0,.10);

        display: flex;
        flex-direction: column;

        gap: 12px;

        transition:
            transform .3s ease,
            box-shadow .3s ease;
    }


    .activity-info:hover{
        transform: translateY(-7px);

        box-shadow:
            0 18px 30px rgba(0,0,0,.15);
    }


    .activity-info > span{
        font-family: 'Montserrat', sans-serif;

        font-weight: 700;

        font-size: 13px;

        color: var(--primary-color);

        letter-spacing: 2px;
    }


    .activity-icon{
        font-size: 35px;
    }


    .activity-info h3{
        color: var(--secondary-color);

        font-size: 1.5rem;
    }


    .activity-info p{
        color: var(--color-text);

        line-height: 1.6;

        font-size: 15px;
    }


    @media screen and (max-width: 1000px){

        .activities-info-grid{
            grid-template-columns:
                repeat(2, 1fr);
        }

    }


    @media screen and (max-width: 600px){

        .activities-info-section{
            padding: 30px 15px 70px;
        }


        .activities-info-grid{
            width: 90%;

            grid-template-columns: 1fr;
        }

    }

</style>