<section class="section doc-section">
    <div class="max-content">
        <div class="title-container" data-aos="fade-up">
            <h2>DOCUMENTOS A PRESENTAR</h2>
            <p>
                (Disponibles también en librerías)
            </p>
        </div>

        <div class="card-container">

            <div class="card">
                <a href="/pdf/inscriptions/Acuerdos-Institucional.pdf" target="_blank" rel="noopener" data-aos="fade-up">
                    <img src="/assets/icons/pdf.svg" alt="Icono de pdf">
                    <div>
                        <h3>Acuerdos Institucionales</h3>
                    </div>
                </a>
            </div>

            <div class="card">
                <a href="/pdf/inscriptions/Autorizacion-imagen.pdf" target="_blank" rel="noopener" data-aos="fade-up">
                    <img src="/assets/icons/pdf.svg" alt="Icono de pdf">
                    <div>
                        <h3>Autorización de imagen</h3>
                    </div>
                </a>
            </div>

            <div class="card">
                <a href="/pdf/inscriptions/constancia-de-examen.pdf" target="_blank" rel="noopener" data-aos="fade-up">
                    <img src="/assets/icons/pdf.svg" alt="Icono de pdf">
                <div>
                    <h3>Constancia de examen</h3>
                </div>
                </a>
                
            </div>

            <div class="card">
                <a href="/pdf/inscriptions/matricula-2026.pdf" target="_blank" rel="noopener" data-aos="fade-up">
                    <img src="/assets/icons/pdf.svg" alt="Icono de pdf">
                <div>
                    <h3>Matricula 2026</h3>
                </div>
                </a>
                
            </div>

            <div class="card">
                <a href="/pdf/inscriptions/Solicitud-Inscripcion.pdf" target="_blank" rel="noopener" data-aos="fade-up">
                    <img src="/assets/icons/pdf.svg" alt="Icono de pdf">
                <div>
                    <h3>solicitud de inscripción</h3>
                </div>
                </a>
                
            </div>
        </div>
    </div>
</section>

<style>
    .doc-section{
        margin-top: 100px;
        display: flex;
        justify-content: center;
    }

    .max-content{
        flex-direction: column;
        align-items: center;
        padding: 40px 20px 60px;
        border-radius: 30px;
    }

    .title-container{
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        margin-bottom: 30px;
    }

    h2{
        font-size: 2rem;
    }

    .title-container p{
        margin-top: 5px;
        opacity: 0.8;
    }

    .card-container{
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;

        width: min(1000px, 90%);
        margin: auto;
    }

    .card{
        border-radius: 20px;

        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.30);

        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease;
    }

    .card:hover{
        transform: translateY(-6px);
        box-shadow: 0 12px 25px rgba(0, 0, 0, 0.45);
    }

    .card a{
        position: relative;
        overflow: hidden;

        text-decoration: none;

        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        gap: 12px;

        min-height: 190px;

        padding: 25px 20px;

        color: #fff;

        background: linear-gradient(
            135deg,
            #0d3d7f,
            #0859c2
        );

        border-radius: 20px;

        text-align: center;

        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .card a::before{
        content: '';

        position: absolute;

        width: 90px;
        height: 90px;

        border-radius: 50%;

        background: rgba(255, 255, 255, 0.08);

        top: -40px;
        right: -40px;
    }

    .card a::after{
        position: absolute;

        bottom: 10px;
        right: 15px;

        font-family: 'BebasNeue', sans-serif;
        font-size: 2rem;

        color: rgba(255, 255, 255, 0.18);
    }


    .card img{
        width: 70px;

        transition: transform 0.25s ease;

        position: relative;
        z-index: 1;
    }

    .card:hover img{
        transform: scale(1.08);
    }

    .card h3{
        position: relative;
        z-index: 1;

        font-size: 1.25rem;
        margin: 0;
    }


    @media screen and (max-width: 768px){

        .doc-section{
            margin-top: 70px;
        }

        .max-content{
            width: 95%;
            padding: 30px 10px 50px;
        }

        .card-container{
            grid-template-columns: 1fr;

            width: 90%;

            gap: 15px;
        }

        .card a{
            min-height: 150px;
        }

        .card h3{
            font-size: 1.15rem;
        }
    }
</style>