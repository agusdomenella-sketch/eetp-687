<section class="section doubt-section">
    <div class="max-content">
        <div class="doubt-container"  data-aos="fade-up">
            <h2>¿Tienes dudas?</h2>
            <p>
                Consultanos mediante nuestro numero de whatsapp entre las 07:40hs y las 18:00hs
            </p>

            <p>
                +54 9 3498 45-7101
            </p>
        </div>
    </div>
</section>

<style>
    .doubt-section{
        margin-top: 100px;
        background-image: url('/assets/images/card-inscription.JPG');
        background-size: cover;
        background-position: 50% 80%;
        padding: 50px 0;
        box-shadow:
            0 -10px 25px rgba(0,0,0,.25),
            0 10px 25px rgba(0,0,0,.25);    
    }

    .max-content{
        justify-content: center;
        align-items: center;
        height: 100%;
    }

    .doubt-container{
        color: #fff;
        display: flex;
        flex-direction: column;
        justify-content: space-evenly;
        align-items: center;
        text-align: center;
        background: #0d3c7fc5;
        width: 600px;
        height: 300px;
        border-radius: 30px;
        box-shadow:0 15px 15px rgba(0, 0, 0, 0.65);
        padding: 20px;
    }

    p{
        font-weight: bold;
    }

    @media screen and (max-width:768px){
        .doubt-container{
            width: 50%;
        }
    }
</style>