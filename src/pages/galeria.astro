<script>

    const images = document.querySelectorAll('.gallery-grid img');

    const modal = document.getElementById('galleryModal');
    const modalImage = document.getElementById('galleryModalImage');

    const closeButton = document.getElementById('galleryClose');
    const prevButton = document.getElementById('galleryPrev');
    const nextButton = document.getElementById('galleryNext');

    let currentImage = 0;


    function openImage(index) {

        currentImage = index;

        modalImage.src = images[currentImage].src;
        modalImage.alt = images[currentImage].alt;

        modal.classList.add('active');

        document.body.style.overflow = 'hidden';
    }


    function closeImage() {

        modal.classList.remove('active');

        document.body.style.overflow = '';
    }


    function nextImage() {

        currentImage++;

        if (currentImage >= images.length) {
            currentImage = 0;
        }

        modalImage.src = images[currentImage].src;
        modalImage.alt = images[currentImage].alt;
    }


    function previousImage() {

        currentImage--;

        if (currentImage < 0) {
            currentImage = images.length - 1;
        }

        modalImage.src = images[currentImage].src;
        modalImage.alt = images[currentImage].alt;
    }


    images.forEach((image, index) => {

        image.addEventListener('click', () => {
            openImage(index);
        });

    });


    closeButton.addEventListener('click', closeImage);

    nextButton.addEventListener('click', nextImage);

    prevButton.addEventListener('click', previousImage);


    modal.addEventListener('click', (event) => {

        if (event.target === modal) {
            closeImage();
        }

    });


    document.addEventListener('keydown', (event) => {

        if (!modal.classList.contains('active')) return;

        if (event.key === 'Escape') {
            closeImage();
        }

        if (event.key === 'ArrowRight') {
            nextImage();
        }

        if (event.key === 'ArrowLeft') {
            previousImage();
        }

    });

</script>


<style>

    /* =========================
       PÁGINA
    ========================== */

    .gallery-page{
        background: var(--third-color);
        padding-bottom: 100px;
    }

    /* =========================
       HERO
    ========================== */

    .gallery-hero{
        min-height: 55vh;

        display: flex;
        align-items: center;
        justify-content: center;

        text-align: center;

        padding: 100px 20px 70px;

        color: white;

        position: relative;

        background-image:
            linear-gradient(
                rgba(6, 53, 114, 0.36),
                rgba(13, 60, 127, 0.48)
            ),
            url('/assets/images/galeria/momentos1.jpg');

        background-size: cover;
        background-position: center;
    }

    .gallery-hero-content{
        position: relative;
        z-index: 1;

        width: 100%;
        max-width: 750px;

        margin: 0 auto;
        padding: 0;

        display: flex;
        flex-direction: column;
        align-items: center;

        text-align: center;
    }

    .gallery-hero-content span,
    .gallery-hero-content h1,
    .gallery-hero-content p{
        text-align: center;
    }

    .gallery-hero-content h1{
        width: auto;
        margin: 0 auto;
    }

    .gallery-hero-content p{
        width: 100%;
        max-width: 650px;
        margin: 0 auto;
    }

    /* =========================
       SECCIONES
    ========================== */

    .gallery-section{
        max-width: 1200px;
        margin: 0 auto;

        padding: 100px 30px 20px;
    }


    /* =========================
       TÍTULOS
    ========================== */

    .gallery-heading{
        display: flex;
        align-items: flex-start;
        gap: 20px;

        margin-bottom: 40px;
    }

    .gallery-heading > span{
        color: var(--fourth-color);
        font-size: 15px;
        font-weight: 800;
        padding-top: 5px;
    }

    .gallery-heading p{
        margin: 0 0 5px;

        color: var(--primary-color);

        font-family: 'Montserrat', sans-serif;
        font-size: 11px;
        font-weight: 700;

        letter-spacing: 2px;
    }

    .gallery-heading h2{
        margin: 0;

        color: var(--secondary-color);

        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 800;
        line-height: 1.1;
    }


    /* =========================
    GALERÍA
    ========================= */

    .gallery-grid{
        column-count: 4;
        column-gap: 16px;
    }

    .gallery-grid img{
        width: 100%;
        height: auto;

        display: block;

        margin-bottom: 16px;

        object-fit: cover;

        border-radius: 18px;

        cursor: pointer;

        break-inside: avoid;

        transition:
            transform .3s ease,
            box-shadow .3s ease;
    }

    .gallery-grid img:hover{
        transform: translateY(-5px);

        box-shadow:
            0 15px 30px rgba(0,0,0,.18);
    }

    /* =========================
       TABLET
    ========================== */

    @media screen and (max-width: 900px){

        .gallery-grid{
            column-count: 2;
            column-gap: 12px;
        }

        .gallery-grid img{
            margin-bottom: 12px;
        }

    }

    /* =========================
       CELULAR
    ========================== */

    @media screen and (max-width: 600px){

        .gallery-hero{
            min-height: 45vh;
            padding: 90px 20px 60px;
        }

        .gallery-hero p{
            font-size: 15px;
        }


        .gallery-section{
            padding: 65px 20px 10px;
        }


        .gallery-heading{
            gap: 12px;
            margin-bottom: 25px;
        }

        .gallery-heading h2{
            font-size: 2rem;
        }

        .gallery-heading p{
            font-size: 9px;
        }

        .gallery-grid{
            column-count: 2;
            column-gap: 10px;
        }

        .gallery-grid img{
            margin-bottom: 10px;
        }

            }

    /* =========================
        VISOR DE IMÁGENES
    ========================= */

    .gallery-modal{
        position: fixed;

        inset: 0;

        width: 100%;
        height: 100%;

        background: rgba(0, 0, 0, .90);

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 40px;

        opacity: 0;
        visibility: hidden;

        transition:
            opacity .3s ease,
            visibility .3s ease;

        z-index: 9999;
    }


    .gallery-modal.active{
        opacity: 1;
        visibility: visible;
    }


    .gallery-modal img{
        max-width: 90%;
        max-height: 88vh;

        object-fit: contain;

