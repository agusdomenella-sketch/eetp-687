        background .3s ease,
        transform .3s ease;

}


.image-modal-close:hover{

    background: rgba(255, 255, 255, 0.3);

    transform: rotate(90deg);

}


/* CELULAR */

@media screen and (max-width: 768px){

    .image-modal{

        padding: 15px;

    }

    .image-modal img{

        max-width: 95%;
