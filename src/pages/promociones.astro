}


/* IMAGEN GRANDE */

.image-modal img{

    max-width: 90%;
    max-height: 90%;

    object-fit: contain;

    border-radius: 15px;

    box-shadow:
        0 10px 40px rgba(0, 0, 0, 0.5);

    transform: scale(.9);

    transition: transform .3s ease;

}


