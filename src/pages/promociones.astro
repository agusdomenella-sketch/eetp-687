---
import Layout from "../layouts/Layout.astro"
import Header from "../components/header.astro"
import Footer from "../components/footer.astro"
import WhatsappBtn from "../components/whatsappBtn.astro"
import BackBtn from "../components/back-btn.astro"

const promociones = [
    { numero: 1985, fotos: 1 },
    { numero: 1986, fotos: 1 },
    { numero: 1991, fotos: 1 },
    { numero: 1992, fotos: 1 },
    { numero: 1993, fotos: 1 },
    { numero: 1994, fotos: 1 },
    { numero: 1995, fotos: 1 },
    { numero: 1996, fotos: 1 },
    { numero: 1997, fotos: 1 },
    { numero: 1998, fotos: 1 },
    { numero: 1999, fotos: 1 },
    { numero: 2000, fotos: 1 },
    { numero: 2001, fotos: 1 },
    { numero: 2002, fotos: 1 },
    { numero: 2003, fotos: 1 },
    { numero: 2004, fotos: 1 },
    { numero: 2006, fotos: 1 },
    { numero: 2007, fotos: 1 },
    { numero: 2008, fotos: 1 },
    { numero: 2009, fotos: 1 },
    { numero: 2010, fotos: 2 },
    { numero: 2011, fotos: 2 },
    { numero: 2012, fotos: 1 },
    { numero: 2013, fotos: 1 },
    { numero: 2014, fotos: 1 },
    { numero: 2015, fotos: 1, extension: "png" },
    { numero: 2016, fotos: 1 },
    { numero: 2017, fotos: 1 },
    { numero: 2018, fotos: 1 },
    { numero: 2019, fotos: 1 },
    { numero: 2020, fotos: 1 },
    { numero: 2021, fotos: 1 },
    { numero: 2022, fotos: 1 },
    { numero: 2023, fotos: 1 },
    { numero: 2024, fotos: 1 },
    { numero: 2025, fotos: 1 },
    { numero: 2026, fotos: 1 }
]
---

<Layout title="Promociones - EETP N°687">

    <Header />

    <main class="promotions-page">

        <!-- ENCABEZADO -->

        <section class="promotions-hero">

            <div class="promotions-title">

                <h1>Promociones de la escuela</h1>

                <p>
                    Un recorrido por las generaciones que formaron parte
                    de nuestra institución a lo largo de los años.
                </p>

            </div>

        </section>


        <!-- PROMOCIONES -->

    <section class="promotions-content">

        <a href="/75-anos" class="promotions-back-btn">
            ← Volver a la historia
        </a>

        <div class="title-container" data-aos="fade-up">
            <h2>Nuestras promociones</h2>
        </div>

            <div class="promotions-grid">

                {
                    promociones.map((promo) => (

                        <div
                            class:list={[
                                "promotion-card",
                                { "double-card": promo.fotos === 2 }
                            ]}
                            data-aos="fade-up"
                        >

                            {
                                promo.fotos === 1 ? (

                                   <div class="promotion-image">

                                        <img
                                            src={`/assets/images/promo-${promo.numero}.${promo.extension ?? "jpg"}`}
                                            alt={`Promoción ${promo.numero}`}
                                            class="promo-clickable"
                                        />

                                    </div>

                                ) : (

                                    <div class="promotion-images">

                                        <img
                                            src={`/assets/images/promo-${promo.numero}.${promo.extension ?? "jpg"}`}
                                            alt={`Promoción ${promo.numero}`}
                                            class="promo-clickable"
                                        />

                                        <img
                                            src={`/assets/images/promo-${promo.numero}(2).${promo.extension ?? "jpg"}`}
                                            alt={`Promoción ${promo.numero} - segunda foto`}
                                            class="promo-clickable"
                                        />

                                    </div>
                                )
                            }


                            <div class="promotion-info">

                                <span>PROMOCIÓN</span>

                                <h3>{promo.numero}</h3>

                            </div>

                        </div>

                    ))
                }

            </div>

        </section>

        <div class="image-modal" id="imageModal">

            <button class="image-modal-close" id="imageModalClose">
                ×
            </button>

            <img id="modalImage" src="" alt="Imagen ampliada">

        </div>

    </main>


    <BackBtn />
    <WhatsappBtn />
    <Footer />

</Layout>


<style>

    /* =========================
       PÁGINA
    ========================= */

    .promotions-page{
        width: 100%;
    }


    /* =========================
       ENCABEZADO
    ========================= */

    .promotions-hero{

        min-height: 400px;

        display: flex;
        justify-content: center;
        align-items: center;

        padding: 100px 20px 70px;

        background:
            linear-gradient(
                rgba(0, 0, 0, 0.45),
                rgba(0, 0, 0, 0.45)
            ),
            url('/assets/images/portada-promo.jpg');

        background-size: cover;
        background-position: center;

    }


    .promotions-title{

        width: 100%;
        max-width: 900px;

        text-align: center;

        color: #fff;

    }


    .promotions-title h1{

        font-size: 5rem;

        margin-bottom: 20px;

    }


    .promotions-title p{

        font-size: 20px;

        line-height: 1.6;

    }


    /* =========================
       CONTENIDO
    ========================= */

    .promotions-content{

        width: 100%;

        max-width: 1200px;

        margin: auto;

        padding: 80px 20px;

    }


    .promotions-content > .title-container{

        margin: 0 auto 50px;

    }


    /* =========================
    BOTÓN VOLVER A HISTORIA
    ========================= */

    .promotions-back-btn{

        display: flex;
        width: fit-content;

        align-items: center;
        justify-content: center;

        margin: 0 auto 40px;

        padding: 12px 30px;

        background: var(--primary-color);
        color: #fff;

        font-family: 'Montserrat', sans-serif;
        font-weight: 600;
        font-size: 16px;

        text-decoration: none;

        border-radius: 30px;

        transition: all .3s ease;

        box-shadow:
            0 5px 12px rgba(0, 0, 0, 0.18);

    }


    .promotions-back-btn:hover{

        background: var(--secondary-color);

        color: #fff;

        transform: translateY(-3px);

        box-shadow:
            0 8px 18px rgba(0, 0, 0, 0.25);

    }


    /* =========================
       GRILLA
    ========================= */

    .promotions-grid{

        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 30px;

    }


    /* =========================
       TARJETAS
    ========================= */

    .promotion-card{

        background: #fff;

        border-radius: 25px;

        overflow: hidden;

        box-shadow:
            0 8px 20px rgba(0, 0, 0, 0.12);

        transition:
            transform .3s ease,
            box-shadow .3s ease;

    }


    .promotion-card:hover{

        transform: translateY(-7px);

        box-shadow:
            0 15px 30px rgba(0, 0, 0, 0.22);

    }


    /* =========================
       FOTO NORMAL
    ========================= */

    .promotion-image{

        width: 100%;

        height: 280px;

        overflow: hidden;

    }


    .promotion-image img{

        width: 100%;
        height: 100%;

        object-fit: cover;

        display: block;

        transition: transform .4s ease;

    }


    .promotion-card:hover .promotion-image img{

        transform: scale(1.04);

    }


    /* =========================
       DOS FOTOS
    ========================= */

    .promotion-images{

        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 5px;

        height: 280px;

        overflow: hidden;

    }


    .promotion-images img{

        width: 100%;
        height: 100%;

        object-fit: cover;

        display: block;

        transition: transform .4s ease;

    }


    .promotion-card:hover .promotion-images img{

        transform: scale(1.03);

    }


    /* =========================
       NOMBRE DE LA PROMOCIÓN
    ========================= */

    .promotion-info{

        display: flex;

        flex-direction: column;

        align-items: center;

        justify-content: center;

        padding: 20px;

        text-align: center;

    }


    .promotion-info span{

        font-family: 'Montserrat', sans-serif;

        font-size: 14px;

        font-weight: 600;

        color: var(--primary-color);

        letter-spacing: 2px;

    }


    .promotion-info h3{

        margin-top: 3px;

        color: var(--secondary-color);

        font-size: 2.5rem;

    }


    /* =========================
       CELULAR
    ========================= */

    @media screen and (max-width: 900px){

        .promotions-grid{

            grid-template-columns:
                repeat(2, 1fr);

        }

    }


    @media screen and (max-width: 768px){

        .promotions-hero{

            min-height: 350px;

            padding: 100px 20px 60px;

        }


        .promotions-title h1{

            font-size: 3.5rem;

        }


        .promotions-title p{

            font-size: 16px;

        }


        .promotions-content{

            padding: 60px 0;

        }


        .promotions-content > .title-container{

            width: 90%;

            margin-bottom: 35px;

        }


        .promotions-grid{

            width: 90%;

            margin: auto;

            grid-template-columns: 1fr;

            gap: 25px;

        }


        .promotion-image{

            height: 250px;

        }


        .promotion-images{

            height: 250px;

        }


        .promotion-info{

            padding: 15px;

        }


        .promotion-info h3{

            font-size: 2.2rem;

        }

    }

    /* =========================
   IMAGEN AMPLIADA
========================= */

.promo-clickable{
    cursor: pointer;
}


/* FONDO OSCURO */

.image-modal{

    position: fixed;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    background: rgba(0, 0, 0, 0.85);

    display: flex;

    align-items: center;
    justify-content: center;

    padding: 30px;

    z-index: 9999;

    opacity: 0;
    visibility: hidden;

    transition:
        opacity .3s ease,
        visibility .3s ease;

}


/* CUANDO SE ABRE */

.image-modal.active{

    opacity: 1;
    visibility: visible;

}


/* IMAGEN GRANDE */

.image-modal img{

    max-width: 90%;
    max-height: 90%;

    object-fit: contain;

    border-radius: 15px;

    box-shadow:
        0 10px 40px rgba(0, 0, 0, 0.5);

    transform: scale(.9);

    transition: transform .3s ease;

}


.image-modal.active img{

    transform: scale(1);

}


/* BOTÓN CERRAR */

.image-modal-close{

    position: absolute;

    top: 25px;
    right: 35px;

    width: 45px;
    height: 45px;

    border: none;

    border-radius: 50%;

    background: rgba(255, 255, 255, 0.15);

    color: #fff;

    font-size: 35px;

    line-height: 1;

    cursor: pointer;

    display: flex;

    align-items: center;
    justify-content: center;

    transition:
        background .3s ease,
        transform .3s ease;

}


.image-modal-close:hover{

    background: rgba(255, 255, 255, 0.3);

    transform: rotate(90deg);

}


/* CELULAR */

@media screen and (max-width: 768px){

    .image-modal{

        padding: 15px;

    }

    .image-modal img{

        max-width: 95%;
        max-height: 85%;

    }

    .image-modal-close{

        top: 15px;
        right: 20px;

    }

}
/* =========================
   IMAGEN AMPLIADA
========================= */

.promo-clickable{
    cursor: pointer;
}


/* FONDO OSCURO */

